# Copy to demo/.env (`make demo-env` does this) and fill in the values.
# Never commit demo/.env.

# --- Model: Moonshot Kimi K3 ---------------------------------------------
# Key from the Moonshot Open Platform (Kimi Coding keys won't work).
MOONSHOT_API_KEY=
# https://api.moonshot.ai/v1 (international) or https://api.moonshot.cn/v1 (China)
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
OPENCLAW_MODEL=moonshot/kimi-k3
# K3 always reasons at max effort on the direct Moonshot route; allow time.
OPENCLAW_TIMEOUT_S=300

# --- Backup model: Gemini 3.5 Flash ----------------------------------------
# Used for a run when Kimi K3 fails (outage, rate limit, auth error).
# API key from Google AI Studio (https://aistudio.google.com/apikey). Turn on billing
# for its project: free-tier content is used to improve Google's products, paid-tier
# content is not. Empty = no working fallback.
GEMINI_API_KEY=
# FALLBACK_MODEL_PRICE_* must match the model. (The older gemini-3.5-flash id is
# served as gemini-3.6-flash; both are in OpenClaw 2026.10.2's catalog.)
# OPENCLAW_FALLBACK_MODEL=google/gemini-3.8-flash

# --- Model on Vertex AI (optional; Google Cloud terms, no training) ---------
# Service account with only roles/aiplatform.user; its JSON key in
# demo/.state/vertex/ (mode 600), mounted read-only at /run/vertex. Then e.g.
#   OPENCLAW_MODEL=google-vertex/gemini-3.7-flash
#   OPENCLAW_FALLBACK_MODEL=google-vertex/gemini-3.6-flash
# and set MODEL_PRICE_* / FALLBACK_MODEL_PRICE_* to Vertex prices.
# Location: Gemini 3.x Flash is served on global, us and eu only (asia-southeast1
# returns 404 for it, checked 2026-10-18). us/eu are multi-regions with in-region
# processing in Google's Service Terms; global has no location guarantee.
# GOOGLE_APPLICATION_CREDENTIALS=/run/vertex/openclaw-vertex.json
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=eu

# --- OpenClaw gateway ----------------------------------------------------
# Generate each with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_HOOK_TOKEN=
# Host port for the demo gateway (default 18790; 18789 is often taken by a
# locally installed OpenClaw gateway).
# OPENCLAW_GATEWAY_HOST_PORT=18790

# --- LINE delivery (not needed for `make demo-dry`) ----------------------
# Messaging API channel from the LINE Developers Console.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Group id (C + 32 hex chars) or user id (U + 32 hex chars) to push reports to.
LINE_TARGET_ID=

# --- Ingestion worker ----------------------------------------------------
# Shared HMAC secret between the Airflow callback and the worker.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=
# Seconds to wait for more failures from the same DAG run before investigating.
DEDUPE_WINDOW_S=30

# --- Phase 3 feedback (optional) -----------------------------------------
# Feedback buttons are on whenever the LINE credentials above are set.
# `make demo-tunnel` uses a Cloudflare quick tunnel (random URL) unless a
# named tunnel token is set; then PUBLIC_WEBHOOK_BASE_URL is its hostname.
# CLOUDFLARE_TUNNEL_TOKEN=
# PUBLIC_WEBHOOK_BASE_URL=https://openclaw-feedback.example.com
# Derived from WEBHOOK_SECRET when unset.
# FEEDBACK_SIGNING_KEY=
# FEEDBACK_USER_SALT=

# --- Public dashboard behind Cloudflare Access (optional) -----------------
# Tunnel public hostname dashboard.<domain> -> http://ingestion-worker:8092,
# protected by a Cloudflare Access application. The worker also verifies the
# Access token itself; it serves nothing on 8092 until all three are set.
# CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# CF_ACCESS_AUD=<Application Audience (AUD) tag>
# DASHBOARD_ALLOWED_EMAILS=you@example.com

# --- Airflow (simple auth manager) ---------------------------------------
# UI login: admin / AIRFLOW_ADMIN_PASSWORD
AIRFLOW_ADMIN_PASSWORD=
# Read-only "investigator" user used by the worker and the agent's log tool.
AIRFLOW_VIEWER_PASSWORD=
# Optional: "dashboard" user (role user) for the dashboard's "Run pipeline" button.
# Generate with: openssl rand -hex 16
# AIRFLOW_TRIGGER_PASSWORD=
# AIRFLOW_IMAGE=apache/airflow:3.3.2

# --- Databricks pipeline (optional; databricks_daily_revenue DAG) ----------
# Workspace URL and the deployed job id (`make lakehouse-deploy` prints/creates it).
# DATABRICKS_HOST=https://<workspace>.gcp.databricks.com
# DATABRICKS_JOB_ID=
# OAuth client credentials of two service principals:
#  - runner: CAN_MANAGE_RUN on the job; used only by Airflow to start runs
#  - reader: CAN_VIEW on the job; used only by the investigator's get_databricks_run_error
# DATABRICKS_RUNNER_CLIENT_ID=
# DATABRICKS_RUNNER_CLIENT_SECRET=
# DATABRICKS_READER_CLIENT_ID=
# DATABRICKS_READER_CLIENT_SECRET=

# --- Git evidence for the investigator (optional) --------------------------
# Default: the seeded demo repo (local). For a real repository on GitHub, use a
# fine-grained token limited to that repo with Contents: read-only.
# GIT_PROVIDER=github
# GITHUB_REPO=owner/repo
# GITHUB_TOKEN=
# GIT_REF=main
# Tried when a path is not in the repo, e.g. airflow/ when DAGs live in airflow/dags/.
# GIT_PATH_PREFIXES=airflow/

# --- Cost tracking (optional) -----------------------------------------------
# Model prices in USD per million tokens, from your provider's price list. Without
# them the dashboard shows token counts only. Cache reads default to the input price.
# MODEL_PRICE_INPUT_PER_MTOK=
# MODEL_PRICE_OUTPUT_PER_MTOK=
# MODEL_PRICE_CACHE_READ_PER_MTOK=
# Gemini 3.6/3.7 Flash prices (AI Studio paid tier and Vertex) through 2026-12-31 (output
# includes thinking). From 2027-01-01 they double: 1.50 / 7.50 / 0.15, for MODEL_PRICE_*
# too when the primary model is Gemini.
# FALLBACK_MODEL_PRICE_INPUT_PER_MTOK=0.75
# FALLBACK_MODEL_PRICE_OUTPUT_PER_MTOK=3.75
# FALLBACK_MODEL_PRICE_CACHE_READ_PER_MTOK=0.075

# --- Alerts (optional): Healthchecks.io -------------------------------------
# Create two checks at https://healthchecks.io and paste their ping URLs.
# Heartbeat: period 5 min, grace 10 min. Emails when the worker, the server or its
# internet is down, the OpenClaw gateway is not ready, or the daily backup failed.
# HEALTHCHECK_URL=https://hc-ping.com/<uuid>
# LINE: period 365 days (it is pinged only when a LINE push happens). Emails when a
# push fails and again when the next one succeeds.
# HEALTHCHECK_LINE_URL=https://hc-ping.com/<uuid>
# HEALTHCHECK_INTERVAL_S=300

# --- Feedback log backups ------------------------------------------------------
# Daily copy of feedback.db in demo/.state/feedback/backups; number of days kept (0 = off).
# FEEDBACK_BACKUP_KEEP=14

# --- Host settings (servers) ---------------------------------------------
# Linux: your uid (id -u), so Airflow can write its bind-mounted files.
# AIRFLOW_UID=1000
# Airflow login page on the LAN: bind to the server's IP and use it as the base URL.
# Use a strong AIRFLOW_ADMIN_PASSWORD before doing this.
# AIRFLOW_BIND_ADDRESS=192.168.1.10
# AIRFLOW_PUBLIC_URL=http://192.168.1.10:8080
# Host ports (loopback only), if the defaults are taken.
# AIRFLOW_HOST_PORT=8080
# WORKER_HOST_PORT=8090
# WEBHOOK_HOST_PORT=8091

# --- Watching another Airflow (production) ---------------------------------
# Empty = don't start the demo Airflow container (compose profile "demo"); make
# targets read this line too. Leave the demo stack's default (demo) otherwise.
# COMPOSE_PROFILES=
# Airflow 3 API base URL and its read-only (Viewer role) account; the password
# goes in AIRFLOW_VIEWER_PASSWORD. Leave AIRFLOW_TRIGGER_PASSWORD unset there:
# the dashboard's Run pipeline button is then off.
# AIRFLOW_BASE_URL=http://192.168.1.20:8080
# AIRFLOW_VIEWER_USERNAME=investigator
# Callback-only listener (POST /v1/airflow/failure, HMAC) for an Airflow on another
# host: bind to the server's LAN IP and allow only the Airflow host in the firewall.
# INGEST_BIND_ADDRESS=192.168.1.49
# INGEST_HOST_PORT=8094
# Read-only clone of the DAG repository for git evidence (GIT_PROVIDER=local),
# refreshed by a cron `git pull`.
# GIT_REPO_DIR=/home/prapon/prod-dags

# --- Production Airflow on this server (airflow/production/docker-compose.yml) ---
# Generate the secrets with openssl rand -hex 24/32; the Fernet key with
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# PROD_AIRFLOW_ADMIN_PASSWORD=
# PROD_AIRFLOW_DB_PASSWORD=
# PROD_AIRFLOW_JWT_SECRET=
# PROD_AIRFLOW_FERNET_KEY=
# PROD_AIRFLOW_BIND_ADDRESS=192.168.1.10
# PROD_AIRFLOW_HOST_PORT=8081
# PROD_AIRFLOW_PUBLIC_URL=http://192.168.1.10:8081
# Read-only clone of the DAG repository (default ~/prod-dags next to this checkout).
# PROD_DAGS_REPO=/home/you/prod-dags
# Then point the investigator at it: AIRFLOW_BASE_URL=http://airflow-prod:8080
